> CREATE FUNCTION public.aviso_visto_hasta_sellar() RETURNS trigger
>     LANGUAGE plpgsql
>     SET search_path TO ''
>     AS $$
> BEGIN
>   NEW.hasta := least(coalesce(NEW.hasta, clock_timestamp()), clock_timestamp());
