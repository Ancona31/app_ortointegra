# ╔══════════════════════════════════════════════════════════════════╗
# ║  Variables de entorno — Spinus®                                ║
# ║  Copiar a .env.local y completar con valores reales            ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── Supabase ──────────────────────────────────────────────────────
# URL del proyecto Supabase (público — visible en el frontend)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Anon key de Supabase (público — visible en el frontend, seguro por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
# Service role key (SECRETO — solo backend, bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...
# Secret del webhook de auth hooks (formato v1,whsec_BASE64)
SUPABASE_HOOK_SECRET=v1,whsec_...

# ─── App ───────────────────────────────────────────────────────────
# URL pública de la app (usado en emails y redirects)
NEXT_PUBLIC_APP_URL=https://www.spinus.com.mx

# ─── Stripe (pagos) ───────────────────────────────────────────────
# Key pública de Stripe (visible en el frontend para Checkout)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Key secreta de Stripe (SECRETO — solo backend)
STRIPE_SECRET_KEY=sk_live_...
# Secret del webhook de Stripe (SECRETO — validar firmas)
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs de precios de Stripe por plan y periodo
STRIPE_PRICE_INDIVIDUAL_MONTHLY=price_...
STRIPE_PRICE_INDIVIDUAL_ANNUAL=price_...
STRIPE_PRICE_BASICA_MONTHLY=price_...
STRIPE_PRICE_BASICA_ANNUAL=price_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_PREMIUM_MONTHLY=price_...
STRIPE_PRICE_PREMIUM_ANNUAL=price_...

# ─── Google OAuth (Calendar) ──────────────────────────────────────
# Credenciales OAuth 2.0 de Google Cloud Console
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://www.spinus.com.mx/api/google/callback
# Key de cifrado AES-256 para tokens de Google (64 chars hex)
GOOGLE_TOKEN_SECRET=0123456789abcdef...

# ─── IA (generación de notas y extracción de labs) ────────────────
# Google Gemini — nota médica y consulta rápida
GEMINI_API_KEY=AIzaSy...
# Anthropic Claude — extracción de laboratorios de PDF
ANTHROPIC_API_KEY=sk-ant-api03-...

# ─── Email (Resend) ───────────────────────────────────────────────
# API key de Resend para emails transaccionales
RESEND_API_KEY=re_...
# Transporte de src/lib/correo/transporte.ts (agenda: reserva por enlace y
# recordatorios). Valores: «resend» en producción; «captura» en local (lo
# captura Mailpit por su API HTTP en http://127.0.0.1:54324 y no sale nada).
# Vacía o con cualquier otro valor: no se envía nada (falla cerrado).
# «resend» se ignora si NEXT_PUBLIC_SUPABASE_URL es local.
# Las rutas viejas (registro, reset, invitación…) todavía llaman a Resend
# directamente y NO leen esta variable.
EMAIL_TRANSPORT=
# Opcional, sólo con «captura»: otra dirección de Mailpit (sólo loopback).
# MAILPIT_URL=

# ─── Reserva por enlace (agenda, bloque D) ────────────────────────
# SECRETO — solo backend. 32 bytes o más en hex (64+ caracteres hex), p. ej.
# `openssl rand -hex 32`. Deriva los códigos de los enlaces y los seudónimos
# (HMAC) de teléfono y correo del candado. Sin él, la reserva falla cerrada.
# ROTARLO invalida TODOS los enlaces emitidos y el historial del candado.
RESERVA_SECRETO=

# ─── Sentry (monitoreo de errores) ────────────────────────────────
# DSN público de Sentry (visible en el frontend)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o12345.ingest.de.sentry.io/67890

# ─── Tareas programadas (Vercel Cron) ─────────────────────────────
# Secreto que Vercel manda como "Authorization: Bearer <valor>" al llamar a
# /api/cron/google-sync (SECRETO — solo backend). Cadena aleatoria de al menos
# 16 caracteres, solo letras y números, sin espacios ni saltos de línea. Sin
# esta variable la ruta responde 401 a todo y no sincroniza nada.
# La misma variable protege /api/cron/recordatorios (agenda E4), que además
# sólo manda correos con EMAIL_TRANSPORT=resend (o captura en local) y
# RESERVA_SECRETO; sin ellos responde {ok:true} sin tomar nada.
CRON_SECRET=
